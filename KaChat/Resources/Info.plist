<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleVersion</key>
	<string>$(KACHAT_BUILD_NUMBER)</string>
	<!-- The version the app shows in About. Xcode Cloud overwrites CFBundleVersion in the
	     archive with its own counter; these two custom keys it leaves alone - see
	     Version.xcconfig. -->
	<key>KaChatBuildNumber</key>
	<string>$(KACHAT_BUILD_NUMBER)</string>
	<key>KaChatIsRelease</key>
	<string>$(KACHAT_IS_RELEASE)</string>
	<key>AppIdentifierPrefix</key>
	<string>$(AppIdentifierPrefix)</string>
	<!-- Export compliance, declared here so App Store Connect stops asking the encryption
	     and France questions on every single TestFlight upload. If KaChat is ever filed for
	     mass-market self-classification with the US BIS, flip this to <true/> and add
	     ITSEncryptionExportComplianceCode with the code Apple issues. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID is used to unlock your seed phrase and sign back in, when enabled in Settings.</string>
	<!-- Every usage string lives here and only here. They used to be split between this file and
	     INFOPLIST_KEY_* build settings, and the camera key was in BOTH with different wording, so
	     which sentence Apple showed depended on merge precedence nobody had written down. -->
	<key>NSCameraUsageDescription</key>
	<string>KaChat uses the camera to scan QR codes when adding contacts and to take photos and videos to send in a chat.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>KaChat uses the microphone to record audio messages and the sound of videos you take to send in a chat.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>KaChat connects to a Kaspa node or a Nextcloud server on your local network only if you configure one.</string>
	<key>NFCReaderUsageDescription</key>
	<string>KaChat uses NFC to save and restore an encrypted backup of your seed phrase on your smart card.</string>
	<!-- KaChat-NFC's applet first, then the card manager, which only tells a card that hasn't been
	     loaded yet from one that isn't a smart card. iOS only reports a card as an ISO 7816 tag
	     when it answers one of these. See NFCCard.swift. -->
	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<string>F04B41434841544E464301</string>
		<string>A000000151000000</string>
	</array>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save received images to your photo library.</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.kachat.app.messageFetch</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.kachat.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kachat</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
